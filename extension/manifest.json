{
  "manifest_version": 3,
  "name": "The Forbidden Library Clipper",
  "version": "1.0.0",
  "description": "Clip any page or selection into a star on your canvases or in a shared room.",
  "icons": { "16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png" },
  "action": { "default_popup": "popup.html", "default_title": "Clip to The Forbidden Library", "default_icon": "icons/icon.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
